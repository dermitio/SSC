---
import "../styles/chat.css";
import chatScriptUrl from "../scripts/chat.js?url";
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" id="favicon" href="/favicon.png?v=1" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#111318" />
    <title>Simple Secure Chat</title>
  </head>
  <body>
    <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>
    <main class="chat-shell" id="chatShell" aria-label="Simple Secure Chat">
      <aside class="app-sidebar" id="sidebarPanel" aria-label="Chat status and participants" aria-hidden="true">
        <div class="brand-lockup">
          <div class="brand-mark" aria-hidden="true">SSC</div>
          <div>
            <p class="eyebrow">SSC</p>
            <h2>Simple Secure Chat</h2>
          </div>
        </div>

        <div class="rail-panel">
          <span class="presence-dot" id="connectionDot" aria-hidden="true"></span>
          <div>
            <p class="rail-label">Connection</p>
            <p class="rail-value" id="connectionText">Connecting</p>
          </div>
        </div>

        <div class="rail-panel">
          <p class="rail-label">Signed in as</p>
          <p class="rail-value" id="currentName">Guest</p>
        </div>

        <div class="rail-panel participants-panel">
          <div>
            <p class="rail-label">Participants</p>
            <div class="participant-list" id="participants"></div>
          </div>
        </div>
      </aside>

      <section class="chat-panel" aria-label="Messages">
        <header class="chat-header">
          <div>
            <p class="eyebrow">Room</p>
            <h2>Main Chat</h2>
          </div>
          <div class="header-actions">
            <button class="icon-button sidebar-toggle" id="sidebarToggle" type="button" title="Show sidebar" aria-label="Show sidebar" aria-controls="sidebarPanel" aria-expanded="false">
              <span aria-hidden="true">▯▮</span>
            </button>
            <button class="icon-button" id="audioCall" type="button" title="Start audio call" aria-label="Start audio call" disabled>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6.4 6.4l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" />
              </svg>
            </button>
            <button class="icon-button" id="videoCall" type="button" title="Start video call" aria-label="Start video call" disabled>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 10.5V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-4.5l5 5v-13Z" />
              </svg>
            </button>
            <button class="icon-button" id="rename" type="button" title="Change name" aria-label="Change name">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 20h9" />
                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
              </svg>
            </button>
          </div>
        </header>

        <section class="call-panel" id="callPanel" aria-label="Call controls" hidden>
          <div class="call-stage">
            <video class="remote-video" id="remoteVideo" autoplay playsinline></video>
            <video class="local-video" id="localVideo" autoplay muted playsinline></video>
            <div class="call-empty" id="callEmpty">Waiting for media</div>
          </div>
          <div class="call-toolbar">
            <div>
              <p class="rail-label">Call</p>
              <p class="rail-value" id="callStatus">Idle</p>
            </div>
            <div class="call-actions">
              <button class="icon-button" id="toggleMic" type="button" title="Mute microphone" aria-label="Mute microphone">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                  <path d="M12 19v3" />
                </svg>
              </button>
              <button class="icon-button" id="toggleCamera" type="button" title="Toggle camera" aria-label="Toggle camera">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 10.5V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-4.5l5 5v-13Z" />
                </svg>
              </button>
              <button class="icon-button danger-button" id="hangup" type="button" title="Hang up" aria-label="Hang up">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M10.7 14.3a10.4 10.4 0 0 1 2.6 0l1.1 2.4a1 1 0 0 0 1 .6l3.5-.7a1 1 0 0 0 .8-.9v-2.5a2 2 0 0 0-.8-1.6 11 11 0 0 0-13.8 0 2 2 0 0 0-.8 1.6v2.5a1 1 0 0 0 .8.9l3.5.7a1 1 0 0 0 1-.6Z" />
                </svg>
              </button>
            </div>
          </div>
        </section>

        <div class="message-list" id="log" aria-live="polite" aria-label="Message history"></div>

        <form class="composer" id="composer" autocomplete="off">
          <button class="icon-button" id="record" type="button" title="Hold to record" aria-label="Hold to record">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
              <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
              <path d="M12 19v3" />
            </svg>
          </button>
          <button class="icon-button" id="attach" type="button" title="Upload file" aria-label="Upload file">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m21.4 11.6-8.8 8.8a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 1 1-2.8-2.8l8.8-8.8" />
            </svg>
          </button>
          <input id="msg" name="message" placeholder="Message..." autocomplete="off" />
          <button class="send-button" id="sendBtn" type="submit">Send</button>
        </form>
      </section>
    </main>

    <div class="recording-popover" id="recPopup" role="status" aria-live="polite">
      <span class="recording-dot" aria-hidden="true"></span>
      <span>Recording</span>
      <span id="recTime">00:00</span>
      <button class="stop-button" id="recStop" type="button">Stop</button>
    </div>

    <div class="incoming-call" id="incomingCall" role="dialog" aria-modal="true" aria-labelledby="incomingTitle" hidden>
      <div>
        <p class="eyebrow">Incoming call</p>
        <h2 id="incomingTitle">Someone is calling</h2>
        <p class="incoming-copy" id="incomingCopy">Audio call</p>
      </div>
      <div class="incoming-actions">
        <button class="stop-button" id="acceptCall" type="button">Accept</button>
        <button class="icon-button danger-button" id="declineCall" type="button" title="Decline call" aria-label="Decline call">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M10.7 14.3a10.4 10.4 0 0 1 2.6 0l1.1 2.4a1 1 0 0 0 1 .6l3.5-.7a1 1 0 0 0 .8-.9v-2.5a2 2 0 0 0-.8-1.6 11 11 0 0 0-13.8 0 2 2 0 0 0-.8 1.6v2.5a1 1 0 0 0 .8.9l3.5.7a1 1 0 0 0 1-.6Z" />
          </svg>
        </button>
      </div>
    </div>

    <input type="file" id="fileInput" hidden />
    <script type="module" src={chatScriptUrl}></script>
  </body>
</html>
